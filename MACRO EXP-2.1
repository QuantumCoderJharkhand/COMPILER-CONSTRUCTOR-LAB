#include <iostream>
#include <string>
using namespace std;

int main()
{
    string program[] =
    {
        "START MACRO",
        "MOV A,B",
        "ADD A,C",
        "MEND",
        "DISPLAY MACRO",
        "MOV R1,R2",
        "MEND",
        "END"
    };

    int i;

    cout << "Macro definitions identified:" << endl;
    cout << "----------------------------" << endl;

    for (i = 0; program[i] != "END"; i++)
    {
        if (program[i].find("MACRO") != string::npos)
        {
            cout << program[i] << endl;
        }
    }

    return 0;
}
